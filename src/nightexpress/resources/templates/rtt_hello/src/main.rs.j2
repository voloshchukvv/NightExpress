//! RTT Hello for {{ chip_id }} (board `{{ board_id }}`).
//!
//! The program logs through the debug probe: flash it with an ST-Link and its messages
//! appear in the "RTT" tab, without a UART adapter. The LED on {{ led_pin }} blinks too.

#![no_std]
#![no_main]

use cortex_m_rt::entry;
use defmt::{info, warn};
use defmt_rtt as _; // the messages go to the debug probe (RTT)
use embassy_stm32::gpio::{Level, Output, Speed};
use panic_probe as _; // a panic is printed in the "RTT" tab, then the core halts

#[entry]
fn main() -> ! {
    // Default clocks: internal oscillator, {{ sysclk_mhz }} MHz.
    let p = embassy_stm32::init(Default::default());
{% if led_active_low %}
    // Level::High = LED off (active low).
    let mut led = Output::new(p.{{ led_pin }}, Level::High, Speed::Low);
{% else %}
    // Level::Low = LED off (active high).
    let mut led = Output::new(p.{{ led_pin }}, Level::Low, Speed::Low);
{% endif %}

    info!("Hello from {{ chip_id }}!");
    let mut counter: u32 = 0;
    loop {
        led.toggle();
        if counter % 10 == 9 {
            warn!("tick {} (every tenth message is a warning)", counter);
        } else {
            info!("tick {}", counter);
        }
        counter = counter.wrapping_add(1);
        // At least {{ half_second_cycles_text }} cycles ~ 0.5 s at {{ sysclk_mhz }} MHz.
        cortex_m::asm::delay({{ half_second_cycles_rust }});
    }
}
