#: src/nightexpress/controllers/app_controller.py src/nightexpress/controllers/upload_controller.py
#: src/nightexpress/views/main_window.py
msgid "Як підключити ST-Link"
msgstr "Cómo conectar un ST-Link"

#: src/nightexpress/controllers/app_controller.py
msgid ""
"SWDIO → SWDIO (PA13), SWCLK → SWCLK (PA14), GND → GND, 3.3V → 3.3V. Перемичка BOOT0 = 0. Потім "
"виберіть ST-Link у меню «Вибрати пристрій»."
msgstr ""
"SWDIO → SWDIO (PA13), SWCLK → SWCLK (PA14), GND → GND, 3.3V → 3.3V. Puente BOOT0 = 0. Después "
"elija el ST-Link en el menú «Elegir dispositivo»."

#: src/nightexpress/controllers/app_controller.py src/nightexpress/views/main_window.py
msgid "Як підключити USB-TTL"
msgstr "Cómo conectar un adaptador USB-TTL"

#: src/nightexpress/controllers/app_controller.py
msgid ""
"Для STM32F1: TX адаптера → PA10, RX адаптера → PA9, GND → GND, рівень 3.3 V. Перед прошиванням: "
"BOOT0 = 1 і натиснути Reset; після — повернути BOOT0 = 0."
msgstr ""
"Para STM32F1: TX del adaptador → PA10, RX del adaptador → PA9, GND → GND, lógica de 3.3 V. Antes "
"de grabar: BOOT0 = 1 y pulse Reset; después vuelva a poner BOOT0 = 0."

#: src/nightexpress/controllers/app_controller.py src/nightexpress/views/main_window.py
msgid "Як прошити через USB (DFU)"
msgstr "Cómo grabar por USB (DFU)"

#: src/nightexpress/controllers/app_controller.py
msgid ""
"Для Black Pill (STM32F401/F411) адаптер не потрібен: під'єднайте плату кабелем USB, затисніть "
"BOOT0, натисніть і відпустіть Reset (NRST), відпустіть BOOT0. Плата з'явиться в меню «Вибрати "
"пристрій» як STM32 BOOTLOADER. Потрібен dfu-util; після прошивання програма запускається сама."
msgstr ""
"Una Black Pill (STM32F401/F411) no necesita adaptador: conecta la placa con un cable USB, mantén "
"BOOT0, pulsa y suelta Reset (NRST) y suelta BOOT0. La placa aparece en el menú «Elegir "
"dispositivo» como STM32 BOOTLOADER. Hace falta dfu-util; tras grabar, el programa arranca solo."

